{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "backend.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "src/services/**/*.ts",
    "dev-server.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
