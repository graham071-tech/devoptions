# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
APP_BASE_URL="MY_APP_BASE_URL"

# ─────────────────────────────────────────────────────────────
# OPTIONAL: THIRD-PARTY VERIFICATION GATEWAYS (PRODUCTION)
# In development & sandbox preview, DevOptions automatically uses
# secure preview OTP dispatching (displayed in UI banner & logs).
# To route through live external production delivery providers:
# ─────────────────────────────────────────────────────────────
# EMAIL PROVIDER (SMTP / SendGrid):
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxxxxxxx"
# SMTP_FROM="no-reply@devoptions.io"

# SMS PROVIDER (Twilio / Africa's Talking):
# TWILIO_ACCOUNT_SID="ACxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxx"
# TWILIO_PHONE_NUMBER="+1234567890"

# ─────────────────────────────────────────────────────────────
# PAYNECTA PAYMENT GATEWAY (M-PESA / KENYAN SHILLINGS)
# Official Documentation: https://docs.paynecta.co.ke/api/
# API Base URL: https://api.paynecta.co.ke/v1
# ─────────────────────────────────────────────────────────────
# PAYNECTA_BASE_URL="https://api.paynecta.co.ke/v1"
# PAYNECTA_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxx"
# PAYNECTA_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxx"
# PAYNECTA_TAPFLOW_ID="tf_xxxxxxxxxxxxxxxx"
# PAYNECTA_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
# In Paynecta Dashboard -> Developers -> Webhooks, register:
# https://YOUR-VERCEL-DOMAIN/api/paynecta/webhook
# Copy that endpoint's signing secret into PAYNECTA_WEBHOOK_SECRET.
# PAYNECTA_KES_PER_USD="130"

