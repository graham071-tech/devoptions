# GEMINI_API_KEY: Set this in Vercel Environment Variables if Gemini features are enabled.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Your deployed Vercel app URL (must use HTTPS for Paynecta).
# APP_BASE_URL: Optional legacy alias for APP_URL.
APP_URL="https://your-app.vercel.app"
APP_BASE_URL="https://your-app.vercel.app"

# SUPABASE SERVER-SIDE DATABASE
# Keep the secret key server-only. Never prefix it with VITE_ or expose it to the browser.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# ─────────────────────────────────────────────────────────────
# OPTIONAL: THIRD-PARTY VERIFICATION GATEWAYS (PRODUCTION)
# In local development, verification codes are shown in the app's development notice.
# In production, configure SMTP and Twilio so codes are delivered out-of-band:
# ─────────────────────────────────────────────────────────────
# EMAIL PROVIDER (SMTP / SendGrid):
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxxxxxxx"
# SMTP_FROM="no-reply@devoptions.io"

# SMS PROVIDER (Twilio):
# TWILIO_ACCOUNT_SID="ACxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxx"
# TWILIO_PHONE_NUMBER="+1234567890"

# ─────────────────────────────────────────────────────────────
# PAYNECTA PAYMENT GATEWAY (M-PESA / KENYAN SHILLINGS)
# Official Documentation: https://docs.paynecta.co.ke/api/
# API Base URL: https://api.paynecta.co.ke/v1
# ─────────────────────────────────────────────────────────────
# PAYNECTA_BASE_URL="https://api.paynecta.co.ke/v1"
# PAYNECTA_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxx"
# PAYNECTA_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxx"
# PAYNECTA_TAPFLOW_ID="tf_xxxxxxxxxxxxxxxx"
# PAYNECTA_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
# In Paynecta Dashboard -> Developers -> Webhooks, register:
# https://YOUR-VERCEL-DOMAIN/api/paynecta/webhook
# Copy that endpoint's signing secret into PAYNECTA_WEBHOOK_SECRET.
# PAYNECTA_KES_PER_USD="130"

